# Postgres connection string. Added automatically when you connect a Neon database in Vercel (Storage tab).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# The first administrator. Created automatically the first time anyone opens the login page
# and the users table is empty. Change the password later from Users > Edit.
ADMIN_EMAIL=you@godrejcp.com
ADMIN_PASSWORD=choose-a-strong-password
